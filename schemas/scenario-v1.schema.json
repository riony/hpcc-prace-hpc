{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prace-hpc.invalid/schemas/scenario-v1.schema.json",
  "title": "PRACE-HPC scenario manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "title",
    "status",
    "description",
    "actor",
    "boundaries",
    "budgets",
    "actions",
    "assertions",
    "redaction",
    "gates",
    "cleanup"
  ],
  "properties": {
    "schema": {
      "const": "prace.scenario.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "status": {
      "enum": [
        "ready",
        "feasibility_required",
        "smoke"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "project",
        "intent"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/name"
        },
        "project": {
          "$ref": "#/$defs/name"
        },
        "intent": {
          "enum": [
            "benign",
            "malicious",
            "reconnaissance"
          ]
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_targets",
        "observation_targets",
        "paths",
        "action_kinds"
      ],
      "properties": {
        "action_targets": {
          "$ref": "#/$defs/nonEmptyUniqueNames"
        },
        "observation_targets": {
          "$ref": "#/$defs/nonEmptyUniqueNames"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "action_kinds": {
          "$ref": "#/$defs/nonEmptyUniqueNames"
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_actions",
        "max_seconds",
        "max_output_bytes"
      ],
      "properties": {
        "max_actions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "max_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "phase",
          "category",
          "description"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/name"
          },
          "phase": {
            "enum": [
              "baseline",
              "attack",
              "record",
              "patched",
              "replay",
              "regression",
              "cleanup",
              "reset"
            ]
          },
          "category": {
            "enum": [
              "security_failure",
              "security_blocked",
              "functional",
              "cleanup"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keys",
        "patterns"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/name"
          }
        },
        "patterns": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "check_ids"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "check_ids": {
          "$ref": "#/$defs/nonEmptyUniqueNames"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "required_actions"
      ],
      "properties": {
        "mode": {
          "const": "discovery"
        },
        "required_actions": {
          "$ref": "#/$defs/nonEmptyUniqueNames"
        }
      }
    }
  },
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "nonEmptyUniqueNames": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "target",
        "identity",
        "parameters",
        "timeout_seconds",
        "capture"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/name"
        },
        "kind": {
          "$ref": "#/$defs/name"
        },
        "target": {
          "$ref": "#/$defs/name"
        },
        "identity": {
          "$ref": "#/$defs/name"
        },
        "parameters": {
          "type": "object"
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "capture": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/name"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "execution"
        ]
      },
      "then": {
        "properties": {
          "status": {
            "const": "smoke"
          }
        }
      }
    }
  ]
}
